# ============================================================================
# Bancas DCBV — variáveis de ambiente
#
# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# .env.local é ignorado pelo git. Sem estas variáveis, o app abre em modo
# demonstração (dados no localStorage).
# ============================================================================

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave publishable (ou anon) do projeto. É pública por design; a proteção
# vem do RLS. Nunca use a service_role no front-end.
VITE_SUPABASE_ANON_KEY=sb_publishable_SUA_CHAVE

# A variável abaixo é aceita como alternativa, caso o painel do Supabase
# mostre o nome "publishable key".
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE
