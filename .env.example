# ============================================================================
# Bancas DCBV — variáveis de ambiente
#
# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# .env.local é ignorado pelo git. Sem estas variáveis, o app abre em modo
# demonstração (dados no localStorage).
#
# O prefixo VITE_ é uma convenção do Vite: ele marca o que pode ser embutido
# no bundle do navegador. A chave anon/publishable é pública por design; a
# proteção real vem do RLS. NUNCA use a service_role no front-end.
#
# O app aceita as duas formas abaixo. Use apenas uma.
# ============================================================================

# Forma padrão do Vite:
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_SUA_CHAVE

# Alternativa aceita para a integração Supabase da Vercel (sem VITE_):
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_SUA_CHAVE

# A variável abaixo também é aceita no lugar de VITE_SUPABASE_ANON_KEY.
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE
